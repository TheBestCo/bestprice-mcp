    "check": "biome ci .",
    "stdio": "node stdio.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12"
  }
