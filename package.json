{
  "name": "bestprice-mcp",
  "version": "1.1.0",
  "private": true,
  "description": "Official BestPrice MCP distribution: client manifests, a stdio bridge to the public Streamable HTTP endpoint, and the browser-native WebMCP contracts.",
  "license": "Apache-2.0",
  "author": {
    "name": "BestPrice",
    "url": "https://www.bestprice.gr/"
  },
  "homepage": "https://www.bestprice.gr/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheBestCo/bestprice-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/TheBestCo/bestprice-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "webmcp",
    "shopping",
    "price-comparison",
    "bestprice",
    "greece"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bestprice-mcp-stdio": "stdio.mjs"
  },
