{
  "name": "bestprice-shopping",
  "version": "2.9.0",
  "description": "Read-only shopping decisions, product search, offers, and price history for Greece.",
  "mcpServers": {
    "bestprice-shopping": {
      "httpUrl": "https://mcp.bestprice.gr/mcp",
      "headers": {
        "X-MCP-Client-Name": "Gemini CLI"
      },
      "includeTools": [
        "get_shopping_decision",
        "search_products",
        "compare_offers",
        "get_price_history",
        "optimize_basket",
        "check_deal"
      ],
      "timeout": 30000
    }
  },
  "contextFileName": "GEMINI.md"
}
